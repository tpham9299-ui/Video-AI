{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dac_ta_canh.v1",
  "title": "Đặc tả cảnh thực tế / xác suất (v1)",
  "description": "AI chỉ mô tả ngữ nghĩa (vật gì, bao nhiêu, màu, kích thước, quan hệ, hành động). Tọa độ do scripts/thu_vien_3d/xep_cho.py tự tính.",
  "type": "object",
  "required": ["phien_ban", "boi_canh", "thuc_the"],
  "additionalProperties": false,
  "properties": {
    "phien_ban": {"const": 1},
    "boi_canh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mau": {"type": ["string", "null"], "pattern": "^[a-z_]{2,40}$"},
        "trong_nha": {"type": "boolean"},
        "thoi_gian": {"enum": ["sang", "trua", "chieu", "toi"]},
        "thoi_tiet": {"enum": ["nang", "may", "mua"]},
        "tu_de": {"type": "string", "maxLength": 160},
        "mo_ta": {"type": "string", "maxLength": 300}
      }
    },
    "thuc_the": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "ten", "lop", "so_luong", "vai_tro"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"},
          "ten": {"type": "string", "minLength": 1, "maxLength": 60},
          "tu_de": {"type": "string", "maxLength": 160},
          "lop": {"enum": ["vat_chua", "phuong_tien", "cong_trinh", "nguoi", "cay", "dong_vat", "do_vat", "do_choi_xac_suat", "noi_that", "thuc_pham", "khac"]},
          "mau_tv": {"type": ["string", "null"], "pattern": "^[a-z_]{2,40}$"},
          "so_luong": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 500}, {"const": "nhieu"}]},
          "mau_sac": {"anyOf": [
            {"type": "string", "pattern": "^(#[0-9a-fA-F]{6}|[a-z_]{2,20})$"},
            {"type": "array", "minItems": 1, "maxItems": 60, "items": {"type": "string", "pattern": "^(#[0-9a-fA-F]{6}|[a-z_]{2,20})$"}}
          ]},
          "vai_tro": {"enum": ["chinh", "phu", "trang_tri"]},
          "kich_thuoc": {
            "type": "object",
            "propertyNames": {"enum": ["dai", "rong", "cao", "duong_kinh", "ban_kinh", "day"]},
            "additionalProperties": {
              "type": "object", "required": ["gt", "dv"], "additionalProperties": false,
              "properties": {
                "gt": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
                "dv": {"enum": ["km", "m", "dm", "cm", "mm"]},
                "nguon": {"enum": ["de", "uoc_luong"]}
              }
            }
          },
          "trang_thai": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "muc_nuoc": {"type": "number", "minimum": 0, "maximum": 1},
              "cat": {"type": "number", "minimum": 0.05, "maximum": 0.4},
              "mo": {"type": "boolean"},
              "xoay": {"type": "number", "minimum": -360, "maximum": 360}
            }
          },
          "bo_phan": {"type": "array", "maxItems": 40, "items": {"type": "object"}, "description": "Do máy sinh (--tu-tao) cho vật chưa có mẫu; AI viết kịch bản không ghi."},
          "co_chuan": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 500}}
        }
      }
    },
    "quan_he": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "required": ["kieu"], "additionalProperties": false,
        "properties": {
          "kieu": {"enum": ["xep_hang", "luoi", "tren", "trong", "canh", "cach", "dua_vao"]},
          "vat": {"type": "string"},
          "a": {"type": "string"},
          "b": {"type": "string"},
          "huong": {"enum": ["ngang", "doc"]},
          "phia": {"enum": ["trai", "phai", "truoc", "sau"]},
          "so_cot": {"type": "integer", "minimum": 1, "maximum": 30},
          "khoang_cach": {
            "type": "object", "required": ["gt", "dv"], "additionalProperties": false,
            "properties": {"gt": {"type": "number", "minimum": 0}, "dv": {"enum": ["km", "m", "dm", "cm", "mm"]}, "tu_de": {"type": "string"}}
          }
        }
      }
    },
    "so_lieu": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "required": ["gan", "nhan"], "additionalProperties": false,
        "properties": {
          "gan": {"type": "string", "pattern": "^([a-z][a-z0-9_]*(#[0-9]+)?\\.(dai|rong|cao|duong_kinh)|khoang_cach:[a-z][a-z0-9_]*(#[0-9]+)?,[a-z][a-z0-9_]*(#[0-9]+)?)$"},
          "nhan": {"type": "string", "minLength": 1, "maxLength": 24},
          "tu_de": {"type": "string", "maxLength": 160}
        }
      }
    },
    "phep_thu": {
      "type": "object", "additionalProperties": false, "required": ["khong_gian", "chon"],
      "properties": {
        "khong_gian": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "chon": {"type": "integer", "minimum": 1, "maximum": 50},
        "hoan_lai": {"type": "boolean"}
      }
    },
    "quay": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "required": ["canh"], "additionalProperties": false,
        "properties": {
          "canh": {"type": "integer", "minimum": 1},
          "tieu_diem": {"type": "array", "items": {"type": "string"}},
          "goc_may": {"enum": ["toan_canh", "trung", "can", "tu_tren", "ngang", "theo_vat"]},
          "chuyen_may": {"enum": ["dung", "luot_vao", "luot_ngang", "xoay_quanh"]},
          "hanh_dong": {
            "type": "array", "maxItems": 8,
            "items": {
              "type": "object", "required": ["vat", "dong_tu"], "additionalProperties": false,
              "properties": {
                "vat": {"type": "string"},
                "dong_tu": {"enum": ["di_chuyen", "roi", "lay_ra", "bo_vao", "tung", "lan", "quay", "rot_day", "gap_hop", "mo", "dong", "xep", "danh_dau_chon", "sang_len", "dung_yen"]},
                "so": {"type": "integer", "minimum": 1},
                "tham_so": {"type": "object"},
                "khi_noi": {"type": "string", "maxLength": 120}
              }
            }
          },
          "hien_so_lieu": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
