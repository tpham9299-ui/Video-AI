      {"tex": "\\triangle ABC \\text{ nhọn } (AB<AC) \\text{ nội tiếp } (O)", "khi_noi": "Cho tam giác ABC nhọn"},
      {"tex": "\\text{Đường cao } BD,\\ CE", "khi_noi": "Kẻ hai đường cao"},
      {"tex": "\\text{Đường kính } AM;\\ DE \\cap AM = I", "khi_noi": "Vẽ đường kính AM"}
