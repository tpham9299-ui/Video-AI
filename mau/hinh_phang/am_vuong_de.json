      {"id": "d2", "loai": "chan_duong_cao", "ten": "D", "tu": "B", "xuong": "AC", "khi_noi": "đường cao BD"},
      {"id": "d3", "loai": "chan_duong_cao", "ten": "E", "tu": "C", "xuong": "AB", "khi_noi": "và CE"},
