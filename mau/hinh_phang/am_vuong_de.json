    {"so": 6, "loai": "tinh_toan", "tieu_de_canh": "Góc ADI bằng góc AMC", "giu_san_khau": true, "giong_doc": "rõ ràng",
     "loi_thoai": "Góc ABC và góc AMC là hai góc nội tiếp cùng chắn cung AC nên bằng nhau. Vậy góc ADI bằng góc AMC.", "noi_dung_man_hinh": []},
    {"so": 7, "loai": "tinh_toan", "tieu_de_canh": "Hai tam giác đồng dạng", "giu_san_khau": true, "giong_doc": "rõ ràng",
