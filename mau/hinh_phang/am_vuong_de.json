    {"so": 4, "loai": "tinh_toan", "tieu_de_canh": "Tứ giác BEDC nội tiếp", "giu_san_khau": true, "giong_doc": "rõ ràng",
     "loi_thoai": "Góc BEC và góc BDC cùng bằng chín mươi độ. Hai tam giác vuông BEC và BDC chung cạnh huyền BC, nên bốn điểm B, E, D, C cùng thuộc đường tròn đường kính BC.", "noi_dung_man_hinh": []},
    {"so": 5, "loai": "tinh_toan", "tieu_de_canh": "Góc ADE bằng góc ABC", "giu_san_khau": true, "giong_doc": "rõ ràng",
