    "muc_tieu": {
      "tex": "AM \\perp DE \\text{ tại } I",
      "khi_noi": "Mục tiêu là chứng minh",
      "to_do": ["AM", "DE", "I"],
      "menh_de": {"loai": "vuong_goc", "a": "AM", "b": "DE"}
    },
    "trang_chung_minh": [
      {"tieu_de": "Tứ giác BEDC nội tiếp", "dong": [
        {"khi_noi": "Góc BEC và góc BDC",
         "tex": "\\mvang{\\angle BEC} = \\mvang{\\angle BDC} = 90^\\circ",
         "menh_de": [{"loai": "goc_so_do", "goc": "BEC", "do": 90}, {"loai": "goc_so_do", "goc": "BDC", "do": 90}],
         "hanh_dong_hinh": [{"loai": "ky_hieu_vuong", "goc": "BEC", "mau": "vang"}, {"loai": "ky_hieu_vuong", "goc": "BDC", "mau": "vang"}]},
        {"khi_noi": "chung cạnh huyền BC",
         "tex": "\\Rightarrow \\mngoc{BEDC} \\text{ nội tiếp đường tròn đường kính } \\mngoc{BC}",
         "menh_de": [{"loai": "dong_vien", "diem": ["B", "E", "D", "C"]}],
         "hanh_dong_hinh": [{"loai": "duong_tron_phu", "duong_kinh": "BC", "mau": "ngoc"}, {"loai": "to_da_giac", "dinh": ["B", "E", "D", "C"], "mau": "ngoc"}]}
      ]},
      {"tieu_de": "Góc ADE bằng góc ABC", "dong": [
        {"khi_noi": "Góc ADE cộng góc EDC",
         "tex": "\\mcam{\\angle ADE} + \\angle EDC = 180^\\circ \\ (\\text{kề bù})",
         "hanh_dong_hinh": [{"loai": "to_goc", "goc": "ADE", "mau": "cam", "so_cung": 1}]},
        {"khi_noi": "góc EBC cộng góc EDC",
         "tex": "\\mdo{\\angle EBC} + \\angle EDC = 180^\\circ \\ (BEDC \\text{ nội tiếp})",
         "hanh_dong_hinh": [{"loai": "to_goc", "goc": "EBC", "mau": "do", "so_cung": 2}]},
        {"khi_noi": "Suy ra góc ADE",
         "tex": "\\Rightarrow \\mcam{\\angle ADE} = \\mdo{\\angle ABC}",
         "hanh_dong_hinh": [{"loai": "khung_bac_cau", "doan_tex": "\\angle EDC", "dong": [1, 2]}]}
      ]},
      {"tieu_de": "Góc ADI bằng góc AMC", "dong": [
        {"khi_noi": "Góc ABC và góc AMC",
         "tex": "\\mdo{\\angle ABC} = \\mla{\\angle AMC} \\ (\\text{cùng chắn cung } AC)",
         "hanh_dong_hinh": [{"loai": "to_goc", "goc": "ABC", "mau": "do", "so_cung": 2}, {"loai": "to_goc", "goc": "AMC", "mau": "la", "so_cung": 2}]},
        {"khi_noi": "Vậy góc ADI",
         "tex": "\\Rightarrow \\mcam{\\angle ADI} = \\mla{\\angle AMC}",
         "hanh_dong_hinh": [{"loai": "to_goc", "goc": "ADI", "mau": "cam", "so_cung": 2}]}
      ]},
      {"tieu_de": "△AID ∼ △ACM", "dong": [
        {"khi_noi": "Góc ACM bằng chín mươi",
         "tex": "\\mngoc{\\angle ACM} = 90^\\circ \\ (\\text{chắn nửa đường tròn})",
         "hanh_dong_hinh": [{"loai": "ky_hieu_vuong", "goc": "ACM", "mau": "ngoc"}]},
        {"khi_noi": "có chung góc A",
         "tex": "\\angle IAD = \\angle CAM,\\ \\mcam{\\angle ADI} = \\mcam{\\angle AMC}",
         "hanh_dong_hinh": [{"loai": "to_goc", "goc": "IAD", "mau": "vang", "so_cung": 1},
                            {"loai": "to_goc", "goc": "ADI", "mau": "cam", "so_cung": 2}, {"loai": "to_goc", "goc": "AMC", "mau": "cam", "so_cung": 2}]},
        {"khi_noi": "Nên tam giác AID đồng dạng",
         "tex": "\\Rightarrow \\mvang{\\triangle AID} \\sim \\mla{\\triangle ACM} \\ (g.g)",
         "menh_de": [{"loai": "dong_dang", "tg1": "AID", "tg2": "ACM"}],
         "hanh_dong_hinh": [{"loai": "to_da_giac", "dinh": ["A", "I", "D"], "mau": "vang"}, {"loai": "to_da_giac", "dinh": ["A", "C", "M"], "mau": "la"}]}
      ]},
      {"tieu_de": "Kết luận", "dong": [
        {"khi_noi": "Từ đó góc AID",
         "tex": "\\Rightarrow \\angle AID = \\mngoc{\\angle ACM} = 90^\\circ"},
        {"khi_noi": "Vậy AM vuông góc",
         "tex": "\\Rightarrow AM \\perp DE \\text{ tại } I",
         "hanh_dong_hinh": [{"loai": "ket_luan", "goc": "AID"}]}
      ]}
    ]
  },
