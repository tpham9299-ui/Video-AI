  {"so": 3, "loai": "kien_thuc", "tieu_de_canh": "Hệ trục", "loi_thoai": "Đặt hệ trục Oxyz, gốc O ở chân tháp A, đơn vị mét. Khi đó A là điểm 0, 0, 200 và B là điểm 600, 0, 300.", "noi_dung_man_hinh": []},
  {"so": 4, "loai": "y_tuong", "tieu_de_canh": "Thử trượt", "loi_thoai": "Thử trượt điểm M trên mặt đất. Tổng AM cộng MB thay đổi liên tục, và có đúng một vị trí nhỏ nhất.", "noi_dung_man_hinh": []},
  {"so": 5, "loai": "giai", "tieu_de_canh": "Đối xứng", "loi_thoai": "Mẹo là lấy đối xứng B qua mặt phẳng Oxy, được B phẩy là điểm 600, 0, âm 300. Khi đó MB luôn bằng MB phẩy.", "noi_dung_man_hinh": []},
  {"so": 6, "loai": "giai", "tieu_de_canh": "Thẳng hàng", "loi_thoai": "Vậy AM cộng MB bằng AM cộng MB phẩy. Cô lập ba điểm A, M, B phẩy: tổng này nhỏ nhất khi ba điểm thẳng hàng.", "noi_dung_man_hinh": []},
  {"so": 7, "loai": "tinh", "tieu_de_canh": "Tính độ dài", "loi_thoai": "Tịnh tiến A theo vectơ OH được A một. Ta có tam giác vuông với hai cạnh 600 và 500, nên AB phẩy bằng căn 610 nghìn, xấp xỉ 781 mét.", "noi_dung_man_hinh": []},
