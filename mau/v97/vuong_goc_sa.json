 "tieu_de": "SA vuông góc đáy: góc và khoảng cách",
 "chu_de_ngan": "Quan hệ vuông góc",
 "hook": "Một đường vuông góc đáy mở khóa cả góc lẫn khoảng cách!",
 "de_bai": "Cho hình chóp S.ABCD có đáy ABCD là hình vuông cạnh a, SA vuông góc với mặt phẳng (ABCD) và SA = a\\sqrt{2}. Chứng minh BD vuông góc với (SAC), tính góc giữa SC và mặt đáy, và khoảng cách từ A đến mặt phẳng (SBC).",
 "can_tim": "BD ⊥ (SAC); góc (SC, (ABCD)); d(A, (SBC))",
 "dap_an_cuoi": "45° và a√6/3",
 "dap_an": "45°; a√6/3",
 "gioi_tinh_giong": "nu",
 "cta": "Lưu lại",
 "canh": [
  {
   "so": 1,
   "loai": "mo_dau",
   "tieu_de_canh": "Câu hỏi",
   "loi_thoai": "Chỉ một cạnh SA vuông góc đáy mà mở khóa được cả góc lẫn khoảng cách. Xem nhé!",
   "noi_dung_man_hinh": []
  },
  {
   "so": 2,
   "loai": "de_bai",
   "tieu_de_canh": "Đề bài",
   "loi_thoai": "Hình chóp S.ABCD có đáy là hình vuông cạnh a, SA vuông góc với đáy và SA bằng a căn hai. Chứng minh BD vuông góc mặt phẳng SAC, tính góc giữa SC và đáy, và khoảng cách từ A đến mặt phẳng SBC.",
   "noi_dung_man_hinh": []
  },
  {
   "so": 3,
   "loai": "giai",
   "tieu_de_canh": "BD vuông góc (SAC)",
   "loi_thoai": "Nhìn từ trên xuống đáy, hai đường chéo của hình vuông vuông góc nên BD vuông góc AC. Mặt khác SA vuông góc đáy nên SA vuông góc BD. Ép mép mặt phẳng SAC lại, ta thấy BD vuông góc với cả mặt phẳng.",
   "noi_dung_man_hinh": [
    "BD \\perp AC,\\ BD \\perp SA",
    "\\Rightarrow BD \\perp (SAC)"
   ]
  },
  {
   "so": 4,
   "loai": "giai",
   "tieu_de_canh": "Góc giữa SC và đáy",
   "loi_thoai": "Xét mặt phẳng SAC. Hình chiếu của SC lên đáy là AC, nên góc cần tìm là góc SCA. Tam giác SAC vuông tại A có SA bằng AC bằng a căn hai, nên tang góc SCA bằng 1, góc bằng bốn mươi lăm độ.",
   "noi_dung_man_hinh": [
    "\\tan\\widehat{SCA} = \\dfrac{SA}{AC} = 1",
    "\\widehat{SCA} = 45^\\circ"
   ]
  },
  {
   "so": 5,
   "loai": "giai",
   "tieu_de_canh": "Khoảng cách từ A",
   "loi_thoai": "Chuyển sang mặt phẳng SAB. Kẻ AH vuông góc SB tại H. Vì BC vuông góc mặt phẳng SAB nên AH vuông góc BC, suy ra AH vuông góc mặt phẳng SBC.",
   "noi_dung_man_hinh": [
    "AH \\perp SB,\\ AH \\perp BC",
    "\\Rightarrow AH \\perp (SBC)"
   ]
  },
  {
   "so": 6,
   "loai": "dap_an",
   "tieu_de_canh": "Kết quả",
   "loi_thoai": "Phóng to vào đoạn AH. Trong tam giác vuông SAB, AH bằng SA nhân AB chia SB, bằng a căn sáu phần ba.",
   "noi_dung_man_hinh": [
    "AH = \\dfrac{SA \\cdot AB}{SB} = \\dfrac{a\\sqrt{6}}{3}"
   ]
  },
  {
   "so": 7,
   "loai": "bai_hoc",
   "tieu_de_canh": "Ghi nhớ",
   "loi_thoai": "Có đường vuông góc đáy thì góc là hình chiếu, khoảng cách là đường cao trong mặt bên. Lưu lại để ôn thi nhé!",
   "noi_dung_man_hinh": []
  }
 ],
